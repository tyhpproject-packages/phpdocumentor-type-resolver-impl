{
    "name": "tyhpdef/phpdocumentor-type-resolver-impl",
    "description": "Implementation package for tyhpdef/phpdocumentor-type-resolver. Require tyhpdef/phpdocumentor-type-resolver, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.0.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/phpdocumentor-reflection-common": "@dev",
                "tyhpdef/phpstan-phpdoc-parser": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/phpdocumentor-type-resolver"
        }
    },
    "require": {
        "php": ">=8.2",
        "phpdocumentor/type-resolver": "2.0.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/phpdocumentor-reflection-common": "@dev",
        "tyhpdef/phpstan-phpdoc-parser": "@dev"
    }
}
